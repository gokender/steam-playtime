# Directory containing gameprocess_log.txt on the host machine.
# CachyOS and most native Steam installations:
HOST_STEAM_LOG_DIR=/home/your-user/.local/share/Steam/logs
# Steam Deck: /home/deck/.local/share/Steam/logs
# Windows: C:/Program Files (x86)/Steam/logs

# Where the host stores the persistent SQLite database.
HOST_DATA_DIR=./data

PUID=1000
PGID=1000
CHECK_INTERVAL=2
LOG_LEVEL=INFO
TZ=Europe/Paris
